<?xml version="1.0" encoding="utf-8" ?>
<otobo_package version="1.0">
    <Name>OTOBO-AI</Name>
    <!-- nofilter(TidyAll::Plugin::OTOBO::SOPM::RequiredElements) -->
    <Version>11.0.0.0</Version>
    <Framework>11.0.x</Framework>
    <Vendor>Rother OSS GmbH</Vendor>
    <URL>https://otobo.io/</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">OTOBO AI interface package to connect to OTOBO AI services.</Description>
    <Description Lang="hu">OTOBO MI-csatolócsomag az OTOBO MI-szolgáltatásokhoz való kapcsolódáshoz.</Description>
    <Filelist>
        <File Permission="660" Location="Custom/Kernel/Output/HTML/ArticleAction/AgentTicketCompose.pm" />
        <File Permission="660" Location="Custom/Kernel/System/TemplateGenerator.pm" />
        <File Permission="660" Location="Custom/Kernel/System/AuthSession/FS.pm" />
        <File Permission="660" Location="Custom/Kernel/System/AuthSession/DB.pm" />
        <File Permission="660" Location="Kernel/Config/Files/XML/OTOBOAIDashboard.xml" />
        <File Permission="660" Location="Kernel/Config/Files/XML/OTOBOAI.xml" />
        <File Permission="660" Location="Kernel/GenericInterface/Operation/Ticket/ArticleDFUpdate.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Operation/Ticket/TicketGetAI.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Operation/ElasticSearch/FAQSearch.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Operation/ElasticSearch/TicketSearch.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Operation/Ticket/Link.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Operation/Ticket/UnLink.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Operation/Ticket/QueryEmbeddings.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Invoker/OTOBOAI/QueryEmbeddings.pm" />
        <File Permission="660" Location="Kernel/System/Console/Command/Maint/AI/QueryEmbeddings.pm" />
        <File Permission="660" Location="Kernel/Language/de_OTOBOAI.pm" />
        <File Permission="660" Location="Kernel/Modules/AdminDynamicFieldTextAreaAI.pm" />
        <File Permission="660" Location="Kernel/Modules/OtoboAIDashboard.pm" />
        <File Permission="660" Location="Kernel/Modules/AgentTicketAIChat.pm" />
        <File Permission="660" Location="Kernel/Output/HTML/ArticleAction/AgentTicketAIChat.pm" />
        <File Permission="660" Location="Kernel/Output/HTML/Dashboard/OtoboAIDashboard.pm" />
        <File Permission="660" Location="Kernel/Output/HTML/Templates/Standard/AgentTicketZoom/AISimilarTickets.tt" />
        <File Permission="660" Location="Kernel/Output/HTML/Templates/Standard/AdminDynamicFieldTextAreaAI.tt" />
        <File Permission="660" Location="Kernel/Output/HTML/Templates/Standard/DynamicField/Agent/TextAreaAI.tt" />
        <File Permission="660" Location="Kernel/Output/HTML/Templates/Standard/OtoboAIDashboard.tt" />
        <File Permission="660" Location="Kernel/Output/HTML/TicketZoom/AISimilarTickets.pm" />
        <File Permission="660" Location="Kernel/System/OtoboAI.pm" />
        <File Permission="660" Location="Kernel/System/OtoboAI/Import.pm" />
        <File Permission="660" Location="Kernel/System/DynamicField/Driver/TextAreaAI.pm" />
        <File Permission="660" Location="Kernel/System/Console/Command/Maint/AI/Import.pm" />
        <File Permission="660" Location="Kernel/System/Console/Command/Maint/AI/Scoring.pm" />
        <File Permission="660" Location="Kernel/System/Console/Command/Maint/AI/GetAnswer.pm" />
        <File Permission="660" Location="Kernel/System/Ticket/Event/OTOBOAIIncrementalSynchronization.pm"/>
        <File Permission="660" Location="Kernel/System/FAQ/Event/OTOBOAIIncrementalSynchronization.pm"/>
        <File Permission="660" Location="Kernel/System/Ticket/Event/PopulateOTOBOAIDynamicField.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Invoker/OTOBOAI/GetAnswer.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Invoker/OTOBOAI/IngestMany.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Invoker/OTOBOAI/Purge.pm" />
        <File Permission="660" Location="var/httpd/htdocs/js/Core.Agent.OtoboAIWidget.js" />
        <File Permission="660" Location="var/httpd/htdocs/skins/Agent/default/css/OtoboAIDashboard.css" />
        <File Permission="660" Location="var/packagesetup/OTOBOAI.pm" />
        <File Permission="660" Location="var/webservices/metadata/OtoboAIProvider.yml" />
    </Filelist>
    <CodeInstall Type="post"><![CDATA[

        # create the package name
        my $CodeModule = 'var::packagesetup::OTOBOAI';

        $Kernel::OM->Get($CodeModule)->CodeInstall();
    ]]></CodeInstall>
    <CodeUpgrade Type="post"><![CDATA[

        # create the package name
        my $CodeModule = 'var::packagesetup::OTOBOAI';

        $Kernel::OM->Get($CodeModule)->CodeUpgrade();
    ]]></CodeUpgrade>
    <CodeUninstall Type="pre"><![CDATA[

        # create the package name
        my $CodeModule = 'var::packagesetup::OTOBOAI';

        $Kernel::OM->Get($CodeModule)->CodeUninstall();
    ]]></CodeUninstall>
    <IntroInstall Type="post" Lang="en" Title="Incremental ingestion of FAQ items"><![CDATA[
        <br/>
        In order for FAQ items to by dynamically synchronized with the OTOBO-AI vector DB, please make sure to
        install the optional <b>Elasticsearch-FAQ</b> package to provide the necessary FAQ event handling.
        <br/>
        <br/>
    ]]></IntroInstall>
    <IntroInstall Type="post" Lang="de" Title="Inkrementelle Aufnahme von FAQ Artikeln"><![CDATA[
        <br/>
        Damit FAQ Artikel dynamisch mit der OTOBO-AI Vector DB synchronisiert werden können, installieren Sie bitte
        das optionale <b>Elasticsearch-FAQ</b> Paket, um das notwendige FAQ Event Handling bereitzustellen.
        <br/>
        <br/>
    ]]></IntroInstall>
    <IntroInstall Type="post" Lang="hu" Title="GyIK-elemek fokozatos bevitele"><![CDATA[
        <br/>
        Ahhoz, hogy a GyIK-elemek dinamikusan szinkronizálódjanak az OTOBO-AI vektoradatbázissal, győződjön meg arról,
        hogy telepítette-e a választható <b>Elasticsearch-FAQ</b> csomagot a szükséges GyIK-események kezelésének
        biztosításához.
        <br/>
        <br/>
    ]]></IntroInstall>
</otobo_package>
