    <Setting Name="Daemon::SchedulerCronTaskManager::Task###RebuildOtoboAIIndex" Required="0" Valid="0" ConfigLevel="100">
        <Description Translatable="1">Rebuilds the OTOBO AI Vector DB index.</Description>
        <Navigation>Daemon::SchedulerCronTaskManager::Task</Navigation>
        <Value>
            <Hash>
                <Item Key="TaskName">RebuildOtoboAIIndex</Item>
                <!--
                    run job once at 01:00 AM in the Morning
                -->
                <Item Key="Schedule">0 1 * * *</Item>
                <Item Key="Module">Kernel::System::Console::Command::Maint::AI::Import</Item>
                <Item Key="Function">Execute</Item>
                <Item Key="MaximumParallelInstances">1</Item>
                <Item Key="Params">
                    <Array>
                        <Item>--target</Item>
                        <Item>tfd</Item>
                        <Item>--reimport</Item>
                        <Item>1</Item>
                    </Array>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Ticket::EventModulePost###8000-PopulateOTOBOAIDynamicField" Required="0" Valid="1">
