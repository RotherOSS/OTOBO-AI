    <Setting Name="DynamicFields::Driver###TextAreaAI" Required="0" Valid="1">
        <Description Translatable="1">DynamicField backend registration.</Description>
        <Navigation>Core::DynamicFields::DriverRegistration</Navigation>
        <Value>
            <Hash>
                <Item Key="DisplayName" Translatable="1">Textarea AI</Item>
                <Item Key="Module">Kernel::System::DynamicField::Driver::TextAreaAI</Item>
                <Item Key="ConfigDialog">AdminDynamicFieldTextAreaAI</Item>
                <Item Key="DisabledAdd">1</Item>
                <Item Key="ObjectTypes">
                    <Array>
                        <Item>Article</Item>
                    </Array>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Daemon::SchedulerCronTaskManager::Task###RebuildOtoboAIIndex" Required="0" Valid="0" ConfigLevel="100">
        <Description Translatable="1">Rebuilds the Otobo AI Vector DB index.</Description>
        <Navigation>Daemon::SchedulerCronTaskManager::Task</Navigation>
        <Value>
            <Hash>
                <Item Key="TaskName">RebuildOtoboAIIndex</Item>
                <!--
                    run job once at 01:00 AM in the Morning
                -->
                <Item Key="Schedule">0 1 * * *</Item>
                <Item Key="Module">Kernel::System::Console::Command::Maint::AI::Import</Item>
                <Item Key="Function">Execute</Item>
                <Item Key="MaximumParallelInstances">1</Item>
                <Item Key="Params">
                    <Array>
                        <Item>--target</Item>
                        <Item>tfd</Item>
                        <Item>--reimport</Item>
                        <Item>1</Item>
                    </Array>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Ticket::EventModulePost###8000-PopulateOTOBOAIDynamicField" Required="0" Valid="1">
        <Description Translatable="1">Event module registration. For asynchronous LLM response collection, you can define trigger events (e.g., TicketCreate). Emitted events are validated against this string using a regular expression; multiple events may be specified, separated by an arbitrary delimiter. The Transition attribute determines when the event is executed: either exactly when it is emitted (0) or at the end of the entire action (1).</Description>
        <Navigation>Core::Event::Ticket</Navigation>
        <Value>
            <Hash>
                <Item Key="Module">Kernel::System::Ticket::Event::PopulateOTOBOAIDynamicField</Item>
                <Item Key="Event">ArticleCreate</Item>
                <Item Key="Transaction">1</Item>
                <Item Key="Queues">
                    <Array>
                    </Array>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Frontend::Module###AdminDynamicFieldTextAreaAI" Required="0" Valid="1">
        <Description Translatable="1">Frontend module registration for the agent interface.</Description>
        <Navigation>Frontend::Admin::ModuleRegistration</Navigation>
        <Value>
            <Item ValueType="FrontendRegistration">
                <Hash>
                    <Item Key="GroupRo">
                        <Array>
                        </Array>
                    </Item>
                    <Item Key="Group">
                        <Array>
                            <Item>admin</Item>
                        </Array>
                    </Item>
                    <Item Key="Description" Translatable="1">This module is part of the admin area of OTOBO.</Item>
                    <Item Key="Title" Translatable="1">Dynamic Fields TextAreaAI Backend GUI</Item>
                    <Item Key="NavBarName">Admin</Item>
                </Hash>
            </Item>
        </Value>
    </Setting>
    <Setting Name="Loader::Module::AdminDynamicFieldTextAreaAI###003-OTOBOAI" Required="0" Valid="1">
        <Description Translatable="1">Loader module registration for the agent interface.</Description>
        <Navigation>Frontend::Admin::ModuleRegistration::Loader</Navigation>
        <Value>
            <Hash>
                <Item Key="JavaScript">
                    <Array>
                        <Item>Core.Agent.Admin.DynamicField.js</Item>
                        <Item>Core.Agent.Admin.DynamicFieldText.js</Item>
                        <Item>Core.Agent.Admin.SysConfig.Entity.js</Item>
                    </Array>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::AnswerTemplateRequestType" Required="0" Valid="1">
        <Description Translatable="1">Define if fetching the AI answer on opening the Answer template should run synchronous or asynchronous.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="Select" SelectedID="Synchronous">
                <Item ValueType="Option" Value="Synchronous" Translatable="1">Synchronous</Item>
                <Item ValueType="Option" Value="Asynchronous" Translatable="1">Asynchronous</Item>
            </Item>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::Placeholder" Required="0" Valid="1">
        <Description Translatable="1">Define a string which is used as a placeholder while waiting for the AI answer.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="String"><![CDATA[<|waiting for AI answer|>]]></Item>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::DynamicFieldOTOBOAI" Required="0" Valid="1">
        <Description Translatable="1">This option defines the dynamic field in which an OTOBOAI answer is stored.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="String">OTOBOAI</Item>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::OverwritePreviousResponse" Required="0" Valid="1">
        <Description Translatable="1">By activating this option, previous AI answers fetched for an article are ignored and a new request to the LLM is started.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="Checkbox">0</Item>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::DoScoringEvaluation" Required="0" Valid="1">
        <Description Translatable="1">By activating this option, otobo-ai will do an additional scoring of the LLM GetAnswer requests.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="Checkbox">0</Item>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::StripSignatureRegex" Required="0" Valid="0">
        <Description Translatable="1">Try to strip Signatures from Ticket Articles during import. The value is a Regular Expression - anything after this match will be stripped.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="String">^--$</Item>
        </Value>
    </Setting>

    <Setting Name="OTOBOAI::AllowedArticleSenderTypes" Required="0" Valid="1">
        <Description Translatable="1">Array of allowed ArticleSenderTypes to be indexed by OTOBO AI. Valid values are 'customer', 'agent', and 'system'.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Array>
                <Item>agent</Item>
                <Item>customer</Item>
            </Array>
        </Value>
    </Setting>

    <Setting Name="OTOBOAI::OnlyVisibleForCustomer" Required="0" Valid="1">
        <Description Translatable="1">Allow only Articles visible for Customer to be embedded for AI.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
                <Item ValueType="Checkbox">1</Item>
        </Value>
    </Setting>

</otobo_config>
