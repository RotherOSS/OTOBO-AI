    <Setting Name="OTOBOAI::AnswerTemplateRequestType" Required="0" Valid="1">
        <Description Translatable="1">Define if opening the answer template on an article which has no AI answer pre-fetched should block (synchronous) or show a placeholder (asynchronous).</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="Select" SelectedID="Asynchronous">
                <Item ValueType="Option" Value="Synchronous" Translatable="1">Synchronous</Item>
                <Item ValueType="Option" Value="Asynchronous" Translatable="1">Asynchronous</Item>
            </Item>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::Placeholder" Required="0" Valid="1">
        <Description Translatable="1">Define a string which is used as a placeholder while waiting for the AI answer. Only visible is AI answer generation is asynchronous.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="String"><![CDATA[<|        AI answer generation in progress. Please reopen window to check again...     |>]]></Item>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::DynamicFieldOTOBOAI" Required="0" Valid="1">
        <Description Translatable="1">This option defines the dynamic field in which an OTOBOAI answer is stored. It may be included in a response template. If changed, the field has to be created manually.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="String">OTOBOAI</Item>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::OverwritePreviousResponse" Required="0" Valid="1">
        <Description Translatable="1">By activating this option, previous AI answers fetched for an article are ignored and a new request to the LLM is started. This is only useful in development settings and should not be activated in production.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="Checkbox">0</Item>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::StripSignatureRegex" Required="0" Valid="0">
    <Description Translatable="1">Cut off this and subsequent lines from ticket articles during ingestion. The value is a Regular Expression. This is useful to strip reoccurring suffixes like signatures from articles.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="String">^--\s*$</Item>
        </Value>
    </Setting>

