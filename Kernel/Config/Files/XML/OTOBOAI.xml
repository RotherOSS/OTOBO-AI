        </Value>
    </Setting>
    <Setting Name="OTOBOAI::DynamicFieldOTOBOAI::EmptyAnswerToken" Required="0" Valid="1">
        <Description Translatable="1">An LLM may not be capable of outputting an empty string. Adjust the prompt to output this token as substitute for an empty string instead. If the dynamic field receives this token, the resulting OTOBOAI answer template will hold no answer string.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="String">NO_OUTPUT</Item>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::OverwritePreviousResponse" Required="0" Valid="1">
        <Description Translatable="1">By activating this option, previous AI answers fetched for an article are ignored and a new request to the LLM is started. This is only useful in development settings and should not be activated in production.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
            <Item ValueType="Checkbox">0</Item>
        </Value>
    </Setting>
    <Setting Name="OTOBOAI::StripSignatureRegex" Required="0" Valid="0">
        <Description Translatable="1">Cut off this and subsequent lines from ticket articles during ingestion into the RAG. The value is a Regular Expression. This is useful to strip reoccurring suffixes like signatures from articles.</Description>
        <Navigation>Core::OTOBOAI</Navigation>
        <Value>
