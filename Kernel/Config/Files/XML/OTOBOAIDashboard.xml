<?xml version="1.0" encoding="utf-8"?>
<otobo_config version="2.0" init="Application">
    <Setting Name="DashboardBackend###0160-OTOBOAIDashboard" Required="0" Valid="0">
        <Description Translatable="1">Parameters for the dashboard backend of the tickets overview by search template of the agent interface. "Limit" is the number of entries shown by default. "Group" is used to restrict the access to the plugin (e. g. Group: admin;group1;group2;). "Default" determines if the plugin is enabled by default or if the user needs to enable it manually. "CacheTTLLocal" is the cache time in minutes for the plugin. "Mandatory" determines if the plugin is always shown and can not be removed by agents. Note: Only Ticket attributes and Dynamic Fields (DynamicField_NameX) are allowed for DefaultColumns.</Description>
        <Navigation>Frontend::Agent::View::Dashboard</Navigation>
        <Value>
            <Hash>
                <Item Key="Module">Kernel::Output::HTML::Dashboard::OtoboAIDashboard</Item>
                <Item Key="Title" Translatable="1">OTOBO-AI Bot</Item>
                <Item Key="Description" Translatable="1">Automatic responses from OTOBO Bot.</Item>
                <Item Key="Filter" Translatable="1">All</Item>
                <Item Key="Time">Age</Item>
                <Item Key="Limit">10</Item>
                <Item Key="Permission">rw</Item>
                <Item Key="Block">ContentLarge</Item>
                <Item Key="Group"></Item>
                <Item Key="Default">1</Item>
                <Item Key="CacheTTLLocal">0.5</Item>
                <Item Key="DefaultColumns">
                    <Hash>
                        <DefaultItem ValueType="Select">
                            <Item ValueType="Option" Value="0" Translatable="1">0 - Disabled</Item>
                            <Item ValueType="Option" Value="1" Translatable="1">1 - Available</Item>
                            <Item ValueType="Option" Value="2" Translatable="1">2 - Enabled by default</Item>
                        </DefaultItem>
                        <Item Key="Age" SelectedID="2"></Item>
                        <Item Key="Changed" SelectedID="1"></Item>
                        <Item Key="Created" SelectedID="1"></Item>
                        <Item Key="CustomerCompanyName" SelectedID="1"></Item>
                        <Item Key="CustomerID" SelectedID="1"></Item>
                        <Item Key="CustomerName" SelectedID="1"></Item>
                        <Item Key="CustomerUserID" SelectedID="1"></Item>
                        <Item Key="EscalationResponseTime" SelectedID="1"></Item>
                        <Item Key="EscalationSolutionTime" SelectedID="1"></Item>
                        <Item Key="EscalationTime" SelectedID="1"></Item>
                        <Item Key="EscalationUpdateTime" SelectedID="1"></Item>
                        <Item Key="TicketNumber" SelectedID="2"></Item>
                        <Item Key="Lock" SelectedID="1"></Item>
                        <Item Key="Owner" SelectedID="1"></Item>
                        <Item Key="PendingTime" SelectedID="1"></Item>
                        <Item Key="Queue" SelectedID="1"></Item>
                        <Item Key="Responsible" SelectedID="1"></Item>
                        <Item Key="Priority" SelectedID="1"></Item>
                        <Item Key="Service" SelectedID="1"></Item>
                        <Item Key="State" SelectedID="1"></Item>
                        <Item Key="SLA" SelectedID="1"></Item>
                        <Item Key="Title" SelectedID="2"></Item>
                        <Item Key="Type" SelectedID="1"></Item>
                    </Hash>
                </Item>
                <Item Key="Mandatory">0</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Loader::Module::AgentDashboard###0160-OTOBOAIDashboard" Required="0" Valid="1">
        <Description Translatable="1">Loader module registration for the agent interface.</Description>
        <Navigation>Frontend::Agent::ModuleRegistration::Loader</Navigation>
        <Value>
            <Hash>
                <Item Key="JavaScript">
                    <Array>
                        <Item>Core.UI.InputFields.js</Item>
                        <Item>Core.Agent.OtoboAIWidget.js</Item>
                    </Array>
                </Item>
                <Item Key="CSS">
                    <Array>
                        <Item>OtoboAIDashboard.css</Item>
                    </Array>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="OtoboAIDashboard::Frontend::TextAreaQuestion" Required="1" Valid="1">
        <Description Translatable="1">Permitted width for compose question windows.</Description>
        <Navigation>Frontend::Agent::View::Dashboard</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="^[0-9]{1,3}$">100</Item>
        </Value>
    </Setting>
    <Setting Name="Frontend::Module###OtoboAIDashboard" Required="0" Valid="1">
        <Description Translatable="1">Frontend module registration for the agent interface.</Description>
        <Navigation>Frontend::Agent::ModuleRegistration</Navigation>
        <Value>
            <Item ValueType="FrontendRegistration">
                <Hash>
                    <Item Key="Group">
                        <Array>
                        </Array>
                    </Item>
                    <Item Key="GroupRo">
                        <Array>
                        </Array>
                    </Item>
                    <Item Key="Description">Otobo AI Dashboard Widget</Item>
                    <Item Key="Title"></Item>
                    <Item Key="NavBarName"></Item>
                </Hash>
            </Item>
        </Value>
    </Setting>
    <Setting Name="OtoboAIDashboard::Frontend::CacheTTL" Required="1" Valid="1">
        <Description Translatable="1">Number of hours of TTL for the Otobo-AI cache elements.</Description>
        <Navigation>Frontend::Agent::View::Dashboard</Navigation>
        <Value>
                <Hash>
                    <Item Key="Request">2</Item>
                    <Item Key="Answer">2</Item>
                </Hash>
        </Value>
    </Setting>
    <Setting Name="OtoboAIDashboard::Frontend::PollingInterval" Required="1" Valid="1">
        <Description Translatable="1">Number of seconds on the client side between attempts to get a cached answer.</Description>
        <Navigation>Frontend::Agent::View::Dashboard</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="^[0-9]{1,3}$">5</Item>
        </Value>
    </Setting>
    <Setting Name="OtoboAIDashboard::Frontend::TimeoutInterval" Required="1" Valid="1">
        <Description Translatable="1">Timeout to consider that a request has no response.</Description>
        <Navigation>Frontend::Agent::View::Dashboard</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="^[0-9]{1,3}$">300</Item>
        </Value>
    </Setting>
</otobo_config>
